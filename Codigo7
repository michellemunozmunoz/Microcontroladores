;=========================================================
; Programa: Alarma LED (PIC18F4550)
; Lenguaje: Ensamblador (MPLAB XC8 Assembler / pic-as)
; Función: Enciende LED en RB0 por 5000 ms y lo apaga por 2000 ms
; Frecuencia: 8 MHz (Oscilador Interno)
;=========================================================

    #include <xc.inc>

;--------------------------------------------
; Configuración de Bits (Fuses)
;--------------------------------------------
    CONFIG  FOSC = INTOSCIO_EC   ; Oscilador interno 8 MHz
    CONFIG  WDT = OFF            ; Watchdog deshabilitado
    CONFIG  LVP = OFF            ; Programación bajo voltaje off
    CONFIG  PBADEN = OFF         ; PORTB como digital

;--------------------------------------------
; Vector de Reset
;--------------------------------------------
    PSECT  resetVec, class=CODE, reloc=2
    ORG     0x00
    GOTO    Inicio               ; 🚩 Aquí usamos GOTO (salto al inicio del programa)

;--------------------------------------------
; Código Principal (flujo del programa)
;--------------------------------------------
    PSECT main_code, class=CODE, reloc=2

Inicio:                          ; 🚩 Sección principal, se entra con GOTO, NO con CALL
    ; Configurar OSCCON a 8 MHz usando INTOSC
    MOVLW   0x72
    MOVWF   OSCCON

    CLRF    TRISB                ; PORTB como salida
    CLRF    LATB                 ; LED apagado al inicio

Loop:                            ; 🚩 Bucle principal, se repite con GOTO
    ; Encender LED 5 segundos
    BSF     LATB, 0              ; LED ON
    MOVLW   5
    MOVWF   Ciclos
DelayOn:
    CALL    Retardo_1s           ; 🚩 Llamada a subrutina (CALL)
    DECFSZ  Ciclos, F
    GOTO    DelayOn

    ; Apagar LED 2 segundos
    BCF     LATB, 0              ; LED OFF
    MOVLW   2
    MOVWF   Ciclos
DelayOff:
    CALL    Retardo_1s           ; 🚩 Otra subrutina llamada con CALL
    DECFSZ  Ciclos, F
    GOTO    DelayOff

    GOTO    Loop                 ; 🚩 Vuelve al bucle principal

;--------------------------------------------
; Subrutina: Retardo de ~1 segundo
;--------------------------------------------
Retardo_1s:                      ; 🚩 Subrutina → siempre se llama con CALL
    MOVLW   25
    MOVWF   ContadorExterno

LoopExterno:
    MOVLW   250
    MOVWF   ContadorInterno

LoopInterno:
    NOP
    NOP
    NOP

    DECFSZ  ContadorInterno, F
    GOTO    LoopInterno

    DECFSZ  ContadorExterno, F
    GOTO    LoopExterno

    RETURN                       ; 🚩 Importante: subrutina siempre termina en RETURN

;--------------------------------------------
; Variables en RAM
;--------------------------------------------
    PSECT udata
ContadorExterno:   DS 1
ContadorInterno:   DS 1
Ciclos:            DS 1

    END

