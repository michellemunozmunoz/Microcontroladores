; Archivo: LED.asm
; Configuración para PIC18F452, MPLAB X IDE v6.25
; Enciende LED 5s y apaga 2s usando reloj interno 8MHz
; Con indicaciones del docente, corregí unos errores de sintaxis como colocar ",A" al lado de " MOVLW ", y demás letras, a su vez se mencionó la falta de "CONFIG  FOSC = INTOSC_EC"
; Sin embargo, el código carece de lógica, al usar funciones con GOTO 

#include <xc.inc>

; CONFIGURACIÓN DEL MICROCONTROLADOR
       ; Oscilador interno OSCCON, pines RA6 y RA7 como I/O
    CONFIG  WDT = OFF       ; Watchdog Timer off
    CONFIG  LVP = OFF       ; Low voltage programming off
    CONFIG  PBADEN = OFF    ; PORTB<4:0> digital
    CONFIG  FOSC = INTOSC_EC 

; Variables en RAM, en BANK0 usando variables de lugar seguro
    Contador1    EQU 0x20
    Contador2    EQU 0x21
    Contador3    EQU 0x22
    Contador12   EQU 0x23

    ORG 0x00
    GOTO inicio

; ------------------------------
inicio:
    ; Configurar oscilador interno 8MHz
    BANKSEL OSCCON
    MOVLW 0x70    ; 
    MOVWF OSCCON

    ; Espera un poco para estabilizar reloj
    NOP
    NOP
    NOP
    NOP


  ; Configurar PORTD como salida
    BANKSEL TRISD
    CLRF    TRISD       ; Puerto D como salida

    BANKSEL LATD
    CLRF    LATD       ; Apaga LEDs inicialmente

loop:
    BANKSEL LATD
    BSF     LATD, 0     ; Enciende LED en RD0
    CALL    retraso5s
    BCF     LATD, 0    ; Apaga LED en RD0
    CALL    retraso2s
    GOTO    loop

; RETARDO DE 5 SEGUNDOS (5000 ms)
retraso5s:
    MOVLW 50       
    MOVWF Contador1
bucle1:
    CALL retraso100ms
    DECFSZ Contador1
    GOTO bucle1
    RETURN 


; RETARDO DE 2 SEGUNDOS (2000 ms)
retraso2s:
    MOVLW 20         
    MOVWF Contador12
bucle12:
    CALL retraso100ms
    DECFSZ Contador12
    GOTO bucle12
    RETURN 

; RETARDO DE 100ms (basado en 8MHz)
retraso100ms:
    MOVLW 250        
    MOVWF Contador2
bucle2:
    MOVLW 250
    MOVWF Contador3
bucle3:
    NOP
    NOP
    DECFSZ Contador3
    GOTO bucle3
    DECFSZ Contador2
    GOTO bucle2
    RETURN

    END
