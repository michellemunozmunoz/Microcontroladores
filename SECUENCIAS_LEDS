; Ajustes de configuración del PIC18F4550
;proyecto de secuencias microcontroladores 

  CONFIG  FOSC = INTOSC_EC      ; Emplear oscilador interno de 8MHz
  CONFIG  WDT = OFF             ; Inhibir el temporizador de vigilancia 
  CONFIG  PBADEN = OFF          ; Establecer pines de PORTB como digitales
  CONFIG  LVP = OFF             ; Deshabilitar programación por bajo voltaje

; Incorporar definiciones específicas del PIC18F4550
#include <xc.inc> 

GLOBAL Configuracion_Inicial
 
  PSECT vector_reset, class=CODE, reloc=2 ; Punto de entrada tras reset
  ORG 0x00 ; Dirección inicial tras reset
  GOTO Configuracion_Inicial ; Saltar a rutina de inicialización
  
  PSECT codigo_principal, class=CODE, reloc=2 ; Segmento de código principal
  
  Configuracion_Inicial:
    ; Ajustar frecuencia del oscilador interno a 8MHz
    MOVLW 0b01110010 ; Patrón binario para oscilador de 8MHz
    MOVWF OSCCON     ; Transferir al registro de control del oscilador
    
    MOVLW 0b00010000 ; RB4 = entrada del boton, RB0/RB3/RB2 = salidas
    MOVWF TRISB       ; Definir todo PORTB como salidas
    CLRF LATB        ; Poner todos los pines de PORTB en estado bajo

 Bucle_Principal:
    BTFSS PORTB,4       ; ¿Está RB4 en alto? (botón presionado)
    GOTO EjecutarSecuencia ; Si no, ir a ejecutar secuencia
    
    ; Si botón presionado, cambiar de secuencia
    INCF Secuencia, F      ; Secuencia++
    MOVF Secuencia, W
    SUBLW  4   
    BTFSC STATUS,Z
    CLRF Secuencia         ; Si llega a 4, reinicia en 0
    INCF Secuencia, F      ; Reinicia en 1
    
    EjecutarSecuencia:
    MOVF Secuencia, W
    SUBLW 1
    BTFSC STATUS,Z
    CALL Secuencia1           ; Si Secuencia=1, pasa a Secuencia1

    MOVF Secuencia, W
    SUBLW 2
    BTFSC STATUS,Z
    CALL Secuencia2          ; Si Secuencia=2, pasa a Secuencia2

    MOVF Secuencia, W
    SUBLW 3
    BTFSC STATUS,Z
    CALL Secuencia3           ; Si Secuencia=3, pasa a Secuencia3

    GOTO Bucle_Principal       ; repite el ciclo principal

;RUTINAS DE SECUENCIA

;Secuencia 1, parpadeo de todos los leds
  Secuencia1:
    MOVLW 0x0F        ; 00001111 → Enciende RB0, RB1, RB2, RB3
    MOVWF LATB        ;enciende simultáneamente los 4 LEDs
    CALL Pausa_1segundo    ; llama a la subrutina de 1 segundo
    CLRF LATB           ; Apaga todos los LEDs
    CALL Pausa_1segundo   ; los mantiene apagados por 1 segundo
    RETURN      ; Vuelva a una instruccion despues del llamado de la secuencia1 en el bucle principal

;Secuencia 2, Alteracion de leds segun pares eh impares 
  Secuencia2: 
    MOVLW 0b00000101 ; Enciende RB0 y RB2
    MOVWF LATB 
    CALL Pausa_1segundo
    MOVLW 0b00001010 ; Enciende RB1 y RB3
    MOVWF LATB 
    CALL Pausa_1segundo
    RETURN          ;   Vuelva a una instruccion despues del llamado de la secuencia2 en el bucle principal 

;Secuencia 3, Carrera de leds uno a uno
Secuencia3:
    MOVLW 0b00000001 ; enciende LED en RB0
    MOVWF LATB 
    CALL Pausa_1segundo
    MOVLW 0b00000010 ; enciende LED en RB1
    MOVWF LATB 
    CALL Pausa_1segundo
    MOVLW 0b00000100 ; enciende LED en RB2
    MOVWF LATB 
    CALL Pausa_1segundo
    MOVLW 0b00001000 ; enciende LED en RB3
    MOVWF LATB 
    CALL Pausa_1segundo
    RETURN               ; Vuelva a una instruccion despues del llamado de la secuencia3 en el bucle principal
    
; Retardo de 1 segundo 
  Pausa_1segundo:
    MOVLW 8          ; Valor para contador de bucle exterior
    MOVWF Contador_Externo ; Guardar en variable de bucle externo
    
  Bucle_Externo:
    MOVLW 200        ; Valor para contador de bucle intermedio
    MOVWF Contador_Intermedio ; Guardar en variable de bucle medio
    
  Bucle_Intermedio:
    MOVLW 250        ; Valor para contador de bucle interior
    MOVWF Contador_Interno ; Guardar en variable de bucle interno
    
  Bucle_Interno:
    NOP              ; Instrucción sin operación (consumir ciclo)
    NOP              ; Consume otro ciclo
    NOP              ; Consume otro ciclo
    DECFSZ Contador_Interno, F ; Decrementar contador interno
    GOTO Bucle_Interno ; Repetir bucle interno
    DECFSZ Contador_Intermedio, F ; Decrementar contador intermedio
    GOTO Bucle_Intermedio ; Repetir bucle intermedio
    DECFSZ Contador_Externo, F ; Decrementar contador externo
    GOTO Bucle_Externo ; Repetir bucle externo
    
    RETURN           ; Regresar de subrutina cuando llegan a cero
    
    PSECT datos_uso
    Secuencia:          DS 1   ; Guarda el número de la secuencia actual
    Contador_Externo:   DS 1 ; Reservar espacio (byte) para contador externo
    Contador_Intermedio: DS 1 ; Reservar espacio (byte) para contador intermedio
    Contador_Interno:    DS 1 ; Reservar espacio (byte) para contador interno
    Contador_Temporal:   DS 1 ; Reservar espacio(byte) para contador temporal
 
  END 


