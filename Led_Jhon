#include <xc.inc>
; CONFIGURACION DEL MICROCONTROLADOR 
CONFIG  PLLDIV = 1            
CONFIG  CPUDIV = OSC1_PLL2    
CONFIG  USBDIV = 2            
CONFIG  FOSC = INTOSCIO_EC    
CONFIG  WDT = OFF            
CONFIG MCLRE= OFF
CONFIG  LVP = OFF  

;VARIABLES EN MEMORIA
Contador1 EQU 0x20
Contador2 EQU 0x21
Contador3 EQU 0x22
Contador12 EQU 0x23
Contador22 EQU 0x24
Contador32 EQU 0x25

ORG 0x00
    GOTO inicio 
inicio:
  MOVLW 0x70           ;Configuracion del oscilador interni a 8MHz
  MOVWF OSCCON

  CLRF TRISD
  CLRF LATD

Loop: 
    BSF LATD, 0
    CALL retraso5s
    BCF LATC, 0
    CALL retraso2s
    GOTO Loop

; RETARDO DE 5 SEGUNDOS
retardo5s:
    MOVLW D'50'
    MOVWF contador1
bucle1:
    CALL retardo100ms
    DECFSZ contador1, F
    GOTO bluque1 
    RETURN

; RETARDO DE 2 SEGUNDOS
retardo2s:
    MOVLW D'20'
    MOVWF contador12
bucle12:
    CALL retardo100ms
    DECFSZ contador12, F
    GOTO bluque12 
    RETURN
;RETARDO DE 100ms (BASADO EN 8MHz)
retraso100ms:
    MOVLW D'250'         
    MOVWF Contador2
bucle2:
    MOVLW D'250'
    MOVWF Contador3
bucle3:
    NOP
    NOP
    DECFSZ Contador3, F
    GOTO bucle3
    DECFSZ Contador2, F
    GOTO bucle2
    RETURN

END
