;======================================
; Programa: Secuencia LEDs con cambio por botón
; Microcontrolador: PIC18F4550
; Compilador : MPLAB X v6.25
; Función: 4 LEDs (RB0-RB3) encienden en secuencia. 
;          Con botón en RB4 cambia la secuencia.
; Frecuencia: 8 MHz (Oscilador Interno)
; Incluye botón
;======================================

 ;---------------------------------------
 ;Configuración de Bits
 ;---------------------------------------
  
CONFIG FOSC = INTOSC_EC ; Oscilador interno a 8MHz
CONFIG WDT = OFF   
CONFIG LVP = OFF
CONFIG PBADEN = OFF

#include <xc.inc>

;-----------------------------------------
; Vector de Reset
;-----------------------------------------
PSECT resetVec, class= CODE, reloc=2
ORG 0x00
GOTO Inicio 

;------------------------------------------
;Programa Principal 
;------------------------------------------
PSECT main_code, class = CODE, reloc = 2
Inicio:

; Oscilador a 8MHz
MOVLW 0b01110010 ;
MOVWF OSCCON

; RB0 - RB3 como salidas, RB4 como entrada
MOVLW 0b00010000
MOVWF TRISB
CLRF LATB

Loop:  
   GOTO Secuencia1

;------------------------------------------------
; Secuencia1: Encendido en zigzag cruzado
;------------------------------------------------
Secuencia1:
MOVLW 0b00010010 ; RB1 y RB4
MOVWF LATB
CALL Retardo_800ms


MOVLW 0b00001100 ; RB2 y RB3
MOVWF LATB
CALL Retardo_500ms


CLRF LATB
CALL Retardo_300ms

BTFSS PORTB, 0 
GOTO Secuencia1
GOTO Secuencia2

GOTO Loop
;------------------------------------------------
;Secuencia 2: Encendido progresivo acumulado
;------------------------------------------------

Secuencia2:
MOVLW   0b00000010
    MOVWF   LATB
    CALL    Retardo_300ms

    MOVLW   0b00000110
    MOVWF   LATB
    CALL    Retardo_300ms

    MOVLW   0b00001110
    MOVWF   LATB
    CALL    Retardo_300ms

    MOVLW   0b00011110
    MOVWF   LATB
    CALL    Retardo_300ms

    CLRF    LATB
    CALL    Retardo_800ms

    BTFSS   PORTB,0
    GOTO    Secuencia2
    GOTO    Secuencia3

;-----------------------------------------------
; Secuencia 3: Encendido tipo rebote rápid
;-----------------------------------------------
Secuencia3:
    MOVLW   0b00000010
    MOVWF   LATB
    CALL    Retardo_200ms

    MOVLW   0b00000100
    MOVWF   LATB
    CALL    Retardo_200ms

    MOVLW   0b00001000
    MOVWF   LATB
    CALL    Retardo_200ms

    MOVLW   0b00010000
    MOVWF   LATB
    CALL    Retardo_200ms

    MOVLW   0b00001000
    MOVWF   LATB
    CALL    Retardo_200ms

    MOVLW   0b00000100
    MOVWF   LATB
    CALL    Retardo_200ms

    CLRF    LATB
    CALL    Retardo_800ms

    BTFSS   PORTB,0
    GOTO    Secuencia3
    GOTO    Secuencia1
;----------------------------------------------------
; Subrutina de retardo
;----------------------------------------------------

Retardo_800ms:
    MOVLW 6
    MOVWF CntExt
Loop1:
    MOVLW 200
    MOVWF CntMed
Loop2:
    MOVLW 250
    MOVWF CntInt
Loop3:
    NOP
    DECFSZ CntInt,F
    GOTO Loop3
    DECFSZ CntMed,F
    GOTO Loop2
    DECFSZ CntExt,F
    GOTO Loop1
    RETURN

Retardo_300ms:
    MOVLW 2
    MOVWF CntExt
Loop4:
    MOVLW 200
    MOVWF CntMed
Loop5:
    MOVLW 250
    MOVWF CntInt
Loop6:
    NOP
    DECFSZ CntInt,F
    GOTO Loop6
    DECFSZ CntMed,F
    GOTO Loop5
    DECFSZ CntExt,F
    GOTO Loop4
    RETURN

Retardo_200ms:
    MOVLW 1
    MOVWF CntExt
Loop7:
    MOVLW 160
    MOVWF CntMed
Loop8:
    MOVLW 250
    MOVWF CntInt
Loop9:
    NOP
    DECFSZ CntInt,F
    GOTO Loop9
    DECFSZ CntMed,F
    GOTO Loop8
    DECFSZ CntExt,F
    GOTO Loop7
    RETURN

;--- Variables en RAM ---
    PSECT udata
CntExt: DS 1
CntMed: DS 1
CntInt: DS 1

    END




