#include <xc.h>
#include <stdint.h>
#include <stdio.h>

#define _XTAL_FREQ 8000000

// CONFIGURACIÓN DEL PIC18F4550
#pragma config FOSC = HSPLL_HS
#pragma config WDT = OFF
#pragma config LVP = OFF
#pragma config PBADEN = OFF
#pragma config MCLRE = ON

//LCD (4 bits) 
#define RS LATB0
#define EN LATB1
#define D4 LATB2
#define D5 LATB3
#define D6 LATB4
#define D7 LATB5

void LCD_Command(unsigned char cmd);
void LCD_Char(unsigned char data);
void LCD_Init(void);
void LCD_String(const char *msg);
void LCD_String_xy(unsigned char row, unsigned char pos);
void LCD_Clear(void);

// I2C Bit-Bang 
#define SDA_LAT LATC
#define SDA_TRIS TRISC
#define SDA_BIT 4

#define SCL_LAT LATC
#define SCL_TRIS TRISC
#define SCL_BIT 3

#define SDA_HIGH()    (SDA_LAT |=  (1<<SDA_BIT))
#define SDA_LOW()     (SDA_LAT &= ~(1<<SDA_BIT))
#define SDA_OUT()     (SDA_TRIS &= ~(1<<SDA_BIT))
#define SDA_IN()      (SDA_TRIS |=  (1<<SDA_BIT))
#define SDA_READ()    ((PORTC >> SDA_BIT) & 1)

#define SCL_HIGH()    (SCL_LAT |=  (1<<SCL_BIT))
#define SCL_LOW()     (SCL_LAT &= ~(1<<SCL_BIT))
#define SCL_OUT()     (SCL_TRIS &= ~(1<<SCL_BIT))
#define SCL_IN()      (SCL_TRIS |=  (1<<SCL_BIT))

// Prototipos I2C
void I2C_Init(void);
void I2C_Start(void);
void I2C_Stop(void);
void I2C_Write(uint8_t data);
uint8_t I2C_Read(uint8_t ack);

// DS1307
#define DS1307_ADDR 0xD0
void DS1307_Init(void);
uint8_t DS1307_IsRunning(void);
void DS1307_SetTime(uint8_t h, uint8_t m, uint8_t s);
void DS1307_SetDate(uint8_t d, uint8_t m, uint8_t y);
void DS1307_GetTime(uint8_t *h, uint8_t *m, uint8_t *s);
void DS1307_GetDate(uint8_t *d, uint8_t *m, uint8_t *y);
uint8_t DecToBCD(uint8_t val);
uint8_t BCDToDec(uint8_t val);

//MAIN 
void main(void) {
    uint8_t h, m, s, d, mt, y;
    char linea1[17], linea2[17];

    // Configuración básica
    OSCCONbits.IRCF = 0b111; // 8 MHz
    ADCON1 = 0x0F;
    CMCON = 0x07;

    TRISB = 0x00; LATB = 0x00; // LCD
    TRISC &= ~((1<<SDA_BIT)|(1<<SCL_BIT)); // I2C como salida inicial

    LCD_Init();
    LCD_Clear();
    DS1307_Init();

    // Si el RTC está detenido, configurar hora y fecha
    if (!DS1307_IsRunning()) {
        LCD_Clear();
        LCD_String_xy(0,0);
        LCD_String("RTC sin hora");
        LCD_String_xy(1,0);
        LCD_String("Ajustando...");
        __delay_ms(2000);

        DS1307_SetTime(15, 32, 0);
        DS1307_SetDate(5, 11, 25);

        LCD_Clear();
        LCD_String_xy(0,0);
        LCD_String("Hora establecida");
        __delay_ms(2000);
    }

    LCD_Clear();
    while(1) {
        DS1307_GetTime(&h,&m,&s);
        DS1307_GetDate(&d,&mt,&y);

        sprintf(linea1,"Fecha:%02d/%02d/20%02d",d,mt,y);
        sprintf(linea2,"Hora:%02d:%02d:%02d",h,m,s);

        LCD_Clear();
        LCD_String_xy(0,0);
        LCD_String(linea1);
        LCD_String_xy(1,0);
        LCD_String(linea2);

        __delay_ms(1000);
    }
}

// LCD FUNCIONES 
void LCD_Command(unsigned char cmd){
    RS = 0;
    D4 = (cmd>>4)&1;
    D5 = (cmd>>5)&1;
    D6 = (cmd>>6)&1;
    D7 = (cmd>>7)&1;
    EN=1; __delay_ms(2); EN=0;
    D4 = cmd&1;
    D5 = (cmd>>1)&1;
    D6 = (cmd>>2)&1;
    D7 = (cmd>>3)&1;
    EN=1; __delay_ms(2); EN=0;
}
void LCD_Char(unsigned char data){
    RS = 1;
    D4 = (data>>4)&1;
    D5 = (data>>5)&1;
    D6 = (data>>6)&1;
    D7 = (data>>7)&1;
    EN=1; __delay_ms(2); EN=0;
    D4 = data&1;
    D5 = (data>>1)&1;
    D6 = (data>>2)&1;
    D7 = (data>>3)&1;
    EN=1; __delay_ms(2); EN=0;
}
void LCD_Init(void){
    LCD_Command(0x02);
    LCD_Command(0x28);
    LCD_Command(0x0C);
    LCD_Command(0x06);
    LCD_Command(0x01);
}
void LCD_String(const char *msg){ while(*msg) LCD_Char(*msg++); }
void LCD_String_xy(unsigned char row,unsigned char pos){
    if(row==0) LCD_Command(0x80+pos);
    else LCD_Command(0xC0+pos);
}
void LCD_Clear(void){ LCD_Command(0x01); __delay_ms(2); }

// I2C FUNCIONES
void I2C_Init(void){
    SDA_OUT(); SCL_OUT();
    SDA_HIGH(); SCL_HIGH();
}
void I2C_Start(void){
    SDA_OUT(); SCL_OUT();
    SDA_HIGH(); SCL_HIGH(); __delay_us(5);
    SDA_LOW(); __delay_us(5);
    SCL_LOW();
}
void I2C_Stop(void){
    SDA_LOW(); SCL_OUT();
    SCL_HIGH(); __delay_us(5);
    SDA_HIGH(); __delay_us(5);
}
void I2C_Write(uint8_t data){
    SDA_OUT();
    for(uint8_t i=0;i<8;i++){
        if(data & 0x80) SDA_HIGH(); else SDA_LOW();
        SCL_HIGH(); __delay_us(5);
        SCL_LOW();
        data <<=1;
    }
    SDA_IN(); // ACK
    SCL_HIGH(); __delay_us(5);
    SCL_LOW();
    SDA_OUT();
}
uint8_t I2C_Read(uint8_t ack){
    uint8_t val=0;
    SDA_IN();
    for(uint8_t i=0;i<8;i++){
        SCL_HIGH(); __delay_us(5);
        val <<=1;
        if(SDA_READ()) val|=1;
        SCL_LOW(); __delay_us(5);
    }
    SDA_OUT();
    if(ack) SDA_LOW(); else SDA_HIGH();
    SCL_HIGH(); __delay_us(5);
    SCL_LOW();
    SDA_HIGH();
    return val;
}

// DS1307 FUNCIONES
void DS1307_Init(void){
    I2C_Start();
    I2C_Write(DS1307_ADDR);
    I2C_Write(0x00);
    I2C_Write(0x00);
    I2C_Stop();
}
uint8_t DS1307_IsRunning(void){
    uint8_t sec;
    I2C_Start();
    I2C_Write(DS1307_ADDR);
    I2C_Write(0x00);
    I2C_Start();
    I2C_Write(DS1307_ADDR|1);
    sec = I2C_Read(0);
    I2C_Stop();
    return !(sec & 0x80);
}
void DS1307_SetTime(uint8_t h,uint8_t m,uint8_t s){
    I2C_Start();
    I2C_Write(DS1307_ADDR);
    I2C_Write(0x00);
    I2C_Write(DecToBCD(s));
    I2C_Write(DecToBCD(m));
    I2C_Write(DecToBCD(h));
    I2C_Stop();
}
void DS1307_SetDate(uint8_t d,uint8_t m,uint8_t y){
    I2C_Start();
    I2C_Write(DS1307_ADDR);
    I2C_Write(0x04);
    I2C_Write(DecToBCD(d));
    I2C_Write(DecToBCD(m));
    I2C_Write(DecToBCD(y));
    I2C_Stop();
}
void DS1307_GetTime(uint8_t *h,uint8_t *m,uint8_t *s){
    I2C_Start();
    I2C_Write(DS1307_ADDR);
    I2C_Write(0x00);
    I2C_Start();
    I2C_Write(DS1307_ADDR|1);
    *s = BCDToDec(I2C_Read(1));
    *m = BCDToDec(I2C_Read(1));
    *h = BCDToDec(I2C_Read(0));
    I2C_Stop();
}
void DS1307_GetDate(uint8_t *d,uint8_t *m,uint8_t *y){
    I2C_Start();
    I2C_Write(DS1307_ADDR);
    I2C_Write(0x04);
    I2C_Start();
    I2C_Write(DS1307_ADDR|1);
    *d = BCDToDec(I2C_Read(1));
    *m = BCDToDec(I2C_Read(1));
    *y = BCDToDec(I2C_Read(0));
    I2C_Stop();
}
uint8_t DecToBCD(uint8_t val){ return ((val/10)<<4) | (val%10);}
uint8_t BCDToDec(uint8_t val){ return ((val>>4)*10) + (val & 0x0F);}

