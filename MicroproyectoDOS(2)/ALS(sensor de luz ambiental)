#include <xc.h> 
#include <stdint.h>
#include <stdio.h>
#include <math.h>   

// Configuración del PIC
#pragma config FOSC = INTOSCIO_EC
#pragma config WDT = OFF
#pragma config LVP = OFF
#pragma config MCLRE = OFF
#pragma config PBADEN = OFF
#define _XTAL_FREQ 8000000
#define I2C_SDA_TRIS TRISBbits.TRISB0
#define I2C_SCL_TRIS TRISBbits.TRISB1
#define I2C_SDA_LAT  LATBbits.LATB0
#define I2C_SCL_LAT  LATBbits.LATB1
#define I2C_SDA_PORT PORTBbits.RB0
#define SENSOR_ADDR 0x39   // dirección 
#define SENSOR_ADDR_WRITE  0x72   // Dirección para escribir
#define SENSOR_ADDR_READ   0x73   // Dirección para leer
#define I2C_DELAY() __delay_us(8)

void I2C_Init(void){
    TRISBbits.TRISB0 = 1; //SDA 
    TRISBbits.TRISB1 = 1; //SCL 
    LATBbits.LATB0 = 1;
    LATBbits.LATB1 = 1;
}

static inline void SCL_H(void){ I2C_SCL_TRIS = 1; I2C_DELAY(); }
static inline void SCL_L(void){ I2C_SCL_TRIS = 0; I2C_SCL_LAT = 0; I2C_DELAY(); }
static inline void SDA_H(void){ I2C_SDA_TRIS = 1; I2C_DELAY(); }
static inline void SDA_L(void){ I2C_SDA_TRIS = 0; I2C_SDA_LAT = 0; I2C_DELAY(); }

void I2C_Start(void){
    SDA_H(); SCL_H();
    SDA_L(); SCL_L();
}

void I2C_Stop(void){
    SDA_L(); SCL_H();
    SDA_H(); I2C_DELAY();
}

uint8_t I2C_WriteByte(uint8_t b){
    for(uint8_t i=0;i<8;i++){
        if(b & 0x80) SDA_H(); else SDA_L();
        SCL_H(); SCL_L();
        b <<= 1;
    }
    SDA_H();
    SCL_H();
    uint8_t ack = (I2C_SDA_PORT == 0);
    SCL_L();
    return ack;
}

uint8_t I2C_ReadByte(uint8_t send_ack){
    uint8_t v=0;
    SDA_H();
    for(uint8_t i=0;i<8;i++){
        v <<= 1;
        SCL_H();
        if(I2C_SDA_PORT) v |= 1;
        SCL_L();
    }
    if(send_ack) SDA_L(); else SDA_H();
    SCL_H(); SCL_L();
    SDA_H();
    return v;
}


// Funciones de Lectura y Escritura del sensor

// Escribe un solo registro
uint8_t Sensor_WriteReg(uint8_t reg, uint8_t data){
    I2C_Start();
    if(!I2C_WriteByte(SENSOR_ADDR_WRITE)){ I2C_Stop(); return 0; }
    if(!I2C_WriteByte(0x80 | reg)){ I2C_Stop(); return 0; }
    if(!I2C_WriteByte(data)){ I2C_Stop(); return 0; }
    I2C_Stop();
    return 1;   
}

int Sensor_ReadReg1(uint8_t reg, uint8_t *out){
    I2C_Start();
    if(!I2C_WriteByte(SENSOR_ADDR_WRITE)){ I2C_Stop(); return 0; }
    if(!I2C_WriteByte(0x80 | reg)){ I2C_Stop(); return 0; }
    I2C_Start();
    if(!I2C_WriteByte(SENSOR_ADDR_READ)){ I2C_Stop(); return 0; }
    *out = I2C_ReadByte(0);  
    I2C_Stop();
    return 1;   
}

int Sensor_ReadReg16(uint8_t regL, uint16_t *out){
    uint8_t lo, hi;
    I2C_Start();
    if(!I2C_WriteByte(SENSOR_ADDR_WRITE)){ I2C_Stop(); return 0; }
    if(!I2C_WriteByte(0x80 | regL)){ I2C_Stop(); return 0; }
    I2C_Start();
    if(!I2C_WriteByte(SENSOR_ADDR_READ)){ I2C_Stop(); return 0; }
    lo = I2C_ReadByte(1);  
    hi = I2C_ReadByte(0);  
    I2C_Stop();
    *out = ((uint16_t)hi << 8) | lo;
    return 1;   
}

// LCD 16x2
#define LCD_RS LATBbits.LATB2
#define LCD_EN LATBbits.LATB3
#define LCD_D4 LATDbits.LATD4
#define LCD_D5 LATDbits.LATD5
#define LCD_D6 LATDbits.LATD6
#define LCD_D7 LATDbits.LATD7

void LCD_Pulse(void){ LCD_EN = 1; __delay_us(40); LCD_EN = 0; __delay_us(40); }

void LCD_Command(uint8_t c){
    LCD_RS = 0;
    LCD_D4 = (c>>4)&1; LCD_D5 = (c>>5)&1; LCD_D6 = (c>>6)&1; LCD_D7 = (c>>7)&1; LCD_Pulse();
    LCD_D4 = (c>>0)&1; LCD_D5 = (c>>1)&1; LCD_D6 = (c>>2)&1; LCD_D7 = (c>>3)&1; LCD_Pulse();
    if(c==0x01) __delay_ms(2);
}

void LCD_PutChar(char ch){
    LCD_RS = 1;
    LCD_D4 = (ch>>4)&1; LCD_D5 = (ch>>5)&1; LCD_D6 = (ch>>6)&1; LCD_D7 = (ch>>7)&1; LCD_Pulse();
    LCD_D4 = (ch>>0)&1; LCD_D5 = (ch>>1)&1; LCD_D6 = (ch>>2)&1; LCD_D7 = (ch>>3)&1; LCD_Pulse();
    __delay_us(120);
}

void LCD_Print(const char *s){ while(*s) LCD_PutChar(*s++); }

void LCD_Init(void){
    TRISBbits.TRISB2 = 0;
    TRISBbits.TRISB3 = 0;
    TRISD &= 0x0F;
    LATB &= ~( (1<<2) | (1<<3) );
    LATD &= 0x0F;
    __delay_ms(20);
    LCD_Command(0x02); LCD_Command(0x28);
    LCD_Command(0x0C); LCD_Command(0x06);
    LCD_Command(0x01); __delay_ms(2);
}

void LCD_SetCursor(uint8_t row, uint8_t col){
    uint8_t addr = (row==1)?0x80:0xC0;
    LCD_Command(addr + (col & 0x0F));
}


// Programa principal
void main(void){
    OSCCON = 0x72;      // 8 MHz
    ADCON1 = 0x0F;      // puertos digitales
    CMCON = 0x07;       // comparadores off

    I2C_Init();
    LCD_Init();

    LCD_SetCursor(1,0);
    LCD_Print("Init TMD2771x");
    __delay_ms(600);

    // Leer ID y STATUS
    uint8_t id = 0, status = 0;
    if(!Sensor_ReadReg1(0x12, &id)){
        LCD_Command(0x01);
        LCD_SetCursor(1,0);
        LCD_Print("No I2C ID");
        while(1);
    }
    Sensor_ReadReg1(0x13, &status);

    char tmp[17];
    LCD_Command(0x01);
    sprintf(tmp, "ID:0x%02X ST:0x%02X", id, status);
    LCD_SetCursor(1,0); LCD_Print(tmp);
    __delay_ms(1200);

    // Configuración del ALS
   Sensor_WriteReg(0x01, 0xE0);  // ATIME (tiempo el sensor acumula luz antes de calcular el resultado).
   Sensor_WriteReg(0x1F, 0x03);  // Ganancia
   Sensor_WriteReg(0x00, 0x01);  // enciende el sensor
   __delay_ms(10);
   Sensor_WriteReg(0x00, 0x03);  // habilita medición de luz

    __delay_ms(200);

    while(1){
    uint16_t als_ch0 = 0, als_ch1 = 0;
    uint8_t st = 0;

    if(!Sensor_ReadReg1(0x13, &st)) continue;
    if(!Sensor_ReadReg16(0x14, &als_ch0)) continue;
    if(!Sensor_ReadReg16(0x16, &als_ch1)) continue;

    //Cálculo simple de luz para TMD27713
    // Luz =
    float factor = 0.6; 
    float als = (als_ch0 > als_ch1) ? (als_ch0 - als_ch1) * factor : 0;

    if(als < 0) als = 0;
    if(als > 65535) als = 65535; // saturación

    LCD_Command(0x01);

    sprintf(tmp, "ST:%02X ID:%02X", st, id);
    LCD_SetCursor(1,0);
    LCD_Print(tmp);

    sprintf(tmp, "ALS:%5u", (unsigned int)als);
    LCD_SetCursor(2,0);
    LCD_Print(tmp);

    __delay_ms(700);
}
}
