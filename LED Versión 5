;Utilizando el PIC18F452

#include <xc.inc>

CONFIG  WDT = OFF
CONFIG  LVP = OFF
CONFIG  FOSC = HS

Contador1    EQU 0x20
Contador2    EQU 0x21
Contador3    EQU 0x22
Contador12   EQU 0x23

ORG 0x00
GOTO inicio

inicio:
    
    NOP 
    NOP 
    NOP
    NOP 

  BANKSEL TRISD
    CLRF    TRISD
    BANKSEL LATD
    CLRF    LATD
    GOTO loop

loop:
    BANKSEL LATD
    BSF     LATD, 0
    CALL    retraso5s
    BCF     LATD, 0
    CALL    retraso2s
    GOTO    loop

retraso5s:
    MOVLW 50
    MOVWF Contador1
bucle1:
    CALL retraso100ms
    DECFSZ Contador1, F
    GOTO bucle1
    RETURN

retraso100ms:
    MOVLW 250
    MOVWF Contador2
bucle2:
    MOVLW 250
    MOVWF Contador3

bucle3:
    NOP
    NOP
    DECFSZ Contador3, F
    GOTO bucle3
    DECFSZ Contador2, F
    GOTO bucle2
    RETURN

END


