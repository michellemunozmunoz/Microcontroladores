// ---------------- PROGRAMA PRINCIPAL ----------------
void main(void) {
    MCU_Init();
    GPIO_Init();
    INT_Init();

    while (1) { 
        //muestra el paso actual de la secuencia actual
        LATD = patrones[secuencia][paso];

        // avanza al siguiente paso
