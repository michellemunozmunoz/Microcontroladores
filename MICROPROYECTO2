//Código de interrupciones y 4 leds (funcional)
//Actualización 6/11/2025 LEDS_INTERRUPCIÓN
#include <xc.h>
#include <pic18f4550.h>
//================================ CONFIGURACIÓN DEL PIC18F4550 =============================
#pragma config FOSC = INTOSCIO_EC
#pragma config WDT = OFF
#pragma config LVP = OFF
#pragma config PBADEN = OFF
#pragma config MCLRE = OFF

#define _XTAL_FREQ 8000000UL 

//================================== PROTOTIPOS =======================================
void Osc_Init(void);
void IO_init(void);
void Int_Init(void);
void aplicarPatron(unsigned char sec, unsigned char paso);
void delay_ms_variable(unsigned int t);

//-------------------------Variables globales-----------------------------------//
volatile unsigned char secuencia = 0; // número de secuencia (072)
volatile unsigned char velocidad = 0; // nivel de velocidad (073)
volatile unsigned int delay_ms_actual = 400; // retardo actual
unsigned char paso = 0;               //paso dentro de la secuencia

//--Tabla de patrones: cada secuencia tiene varios pasos--//
const unsigned char patrones [3] [8] = {
    //Secuencia 0: LED que corre ida y vuelta
    {0b0001, 0b0010, 0b0100, 0b1000, 0b0100, 0b0010, 0b0001, 0b0000},

    //Secuencia 1: efectos binarios (contadores)
    {0b0000, 0b0001, 0b0011, 0b0111, 0b1111, 0b1110, 0b1100, 0b1000},

    // Secuencia 2: luces alternadas
    {0b0101, 0b1010, 0b1111, 0b0000, 0b0110, 0b1001, 0b1111, 0b0000}
};
// ============================ RUTINA DE INTERRUPCIÓN ================================0
void_interrupt() ISR(void) {
   //RB0: cambiar de secuencia
   if (INTCONbits.INT0IF) {
      secuencia++;
      if (secuencia > 2) {
    }
    paso = 0;
    INTCONbits.INT0IF = 0;
}
// RB1: cambiar velocidad 
if (INTCON3.bits.INT1IF) { 
   velocidad++;
   if(velocidad > 3) velocidad = 0;

// actualiza retardo según velocidad
   switch (velocidad) {
      case 0: delay_ms_actual = 600; break;
      case 1: delay_ms_actual = 400; break;
      case 2: delay_ms_actual = 200; break;
      case 3: delay_ms_actual = 100; break;
    }
    INTCON3bits.INT1IF = 0 //limpia bandera
 }
}



// ---------------- PROGRAMA PRINCIPAL ----------------
void main(void) {
    Osc_Init();
    IO_Init();
    Int_Init();
    while (1) { 
        //muestra el paso actual de la secuencia actual
        aplicarPatron (secuencia, paso);

        // avanza al siguiente paso
        paso++;
        if (paso > 7) {
            paso = 0;
        }

        // retardo según la velocidad escogida
        delay_ms_variable(delay_ms_actual);
    }
}

//============================= IMPLEMENTACIÓN DE FUNCIONES ================================

//Configura el oscilador igual que en el código 1 
void Osc_Init(void) { 
     // IRCF = 111 --> 8MHz
     OSCCONbits.IRCF2 = 1;
     OSCCONbits.IRCF1 = 1;
     OSCCONbits.IRCF0 = 1;
     OSCCONbits.SCS   = 1; //usa el oscilador interno
}

//Configura puertos 
void IO_Init(void) { 
   ADCON1 = 0x0F ; //todo digital

   // RD0 .. RD3 como salidas para los LEDs, RD4..RD7 como entradas 
   TRISD = OxF0;
   LATD = 0x00;

   //RB0 y RB1 como entradas (botones)
   TRISBbits.TRISB0 = 1;
   TRISBbits.TRISB1 = 1;

   //deshabilita pull-ups en PORTB
   INTCONT2bits.RBPU = 1;
}

// Configura interrupciones externas como el código 2 pero ordenado
void Int_Init(void) {
    // INT0 en flanco de bajada
    INTCON2bits.INTEDG0 = 0;
    INTCONbits.INT0IF   = 0;
    INTCONbits.INT0IE   = 1;

  // INT1 en flanco de bajada
    INTCON2bits.INTEDG1 = 0;
    INTCON3bits.INT1IF  = 0;
    INTCON3bits.INT1IE  = 1;

    // habilita interrupciones globales
    INTCONbits.GIE  = 1;
    INTCONbits.PEIE = 1;
}

// Manda el patrón al puerto D (solo 4 bits bajos)
void aplicarPatron(unsigned char sec, unsigned pasoLocal) { 
    // limpiamos solo 4 bits bajos
    LATD & = 0xF0;
    LATD |= (patrones [sec] [pasoLocal] & 0x0F);
}

// Retardo variable en ms
void delay_ms_variable(unsigned int t) {
    while (t--) {
        __delay_ms(1);
    }
}
  
