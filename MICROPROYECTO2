//============================= IMPLEMENTACIÓN DE FUNCIONES ================================

//Configura el oscilador igual que en el código 1 
void MCU_Init(void) { 
     // IRCF = 111 --> 8MHz
     OSCCONbits.IRCF = 0b111;   // 8 MHz
     OSCCONbits.SCS  = 0b10;    // usar oscilador interno

     ADCON1 = 0x0F;             // puertos AN como digitales
     CMCON = 0x07;              // comparadores off
}

//Configura puertos 
void GPIO_Init(void) { 
    // RD0..RD3 como salidas (LEDs), RD4..RD7 como entradas/no usados
    TRISD = 0xF0;  // 1111 0000 -> RD0..RD3 salidas
    LATD  = 0x00;

    // Botones en RB0 y RB1
    TRISBbits.TRISB0 = 1;   // entrada
    TRISBbits.TRISB1 = 1;   // entrada

    // Deshabilitar pull-ups de PORTB (o activarlos si quieres)
    INTCON2bits.RBPU = 1;   // 1 = pull-ups desactivados
}


// Configura interrupciones externas como el código 2 pero ordenado
void INT_Init(void) {
    // INT0 en flanco de bajada
    INTCON2bits.INTEDG0 = 0;
    INTCONbits.INT0IF   = 0;
    INTCONbits.INT0IE   = 1;

  // INT1 en flanco de bajada
    INTCON2bits.INTEDG1 = 0;
    INTCON3bits.INT1IF  = 0;
    INTCON3bits.INT1IE  = 1;

    // habilita interrupciones globales
    INTCONbits.GIE  = 1;
}

// actualiza retardo según velocidad
void actualizarRetardo(void)
{
   switch (velocidad) {
      case 0: delay_ms_actual = 600; break;
      case 1: delay_ms_actual = 400; break;
      case 2: delay_ms_actual = 200; break;
      case 3: delay_ms_actual = 100; break;
 }
}

// Retardo variable en ms
void delay_ms_variable(unsigned int t) {
    while (t--) {
        __delay_ms(1);
    }
}
  
