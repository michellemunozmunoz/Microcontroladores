// ============================== RUTINA DE INTERRUPCIÓN ==============================
void _interupt() ISR(void)
{
    //INT0 (RB0) : Cambiar secuencia
    if (INTCONbits.INT0IF) {
       secuencia++;
       if (secuencia > 2) secuencia = 0; // volver a 0 si pasa de 2
       paso = 0;
       INTCONbits.INT0IF = 0;
}

    //INT1(RB1) : cambiar velocidad
    if (INTCON3bits.INT1IF) {
       velocidad++;
       if (velocidad > 3) velocidad = 0; // 4 niveles: 0..3
       actualizarRetardo();
       INTCON3bits.INT1IF = 0;            // limpiar bandera
    }
}
//-------------------------Variables globales-----------------------------------//
volatile unsigned char secuencia = 0; // número de secuencia (072)
