;======================================
; Programa: Secuencia LEDs con cambio por botón
; Micro: PIC18F4550
; Compilador : MPLAB X v6.25
; Función: 4 LEDs (RB0-RB3) encienden en secuencia. 
;          Con botón en RB4 cambia la secuencia.
; Frecuencia: 8 MHz (Oscilador Interno)
; Incluye Botón
;======================================

 ;---------------------------------------
 ;Configuración de Bits
 ;---------------------------------------
  
CONFIG FOSC = INTOSC_EC ; Oscilador interno a 8MHz
CONFIG WDT = OFF   
CONFIG LVP = OFF
CONFIG PBADEN = OFF

#include <xc.inc>

;-----------------------------------------
; Vector de Reset
;-----------------------------------------
PSECT resetVec, class= CODE, reloc=2
ORG 0x00
GOTO Inicio 

;------------------------------------------
;Programa Principal 
;------------------------------------------
PSECT main_code, class = CODE, reloc = 2
Inicio:

; Oscilador a 8MHz
MOVLW 0b01110010 ;
MOVWF OSCCON

; RB0 - RB3 como salidas, RB4 como entrada
MOVLW 0b00010000
MOVWF TRISB
CLRF LATB

Loop:  
   GOTO SecuenciaNormal

;------------------------------------------------
; Secuencia Normal: RB0 --> RB1 --> RB2 --> RB3
;------------------------------------------------
SecuenciaNormal:
BSF LATB, 0
CALL Retardo_500ms
CLRF LATB

BSF LATB, 1
CALL Retardo_500ms
CLRF LATB

BSG LATB, 2
CALL Retardo_500ms
CLRF LATB

BSF LATB, 3
CALL Retardo_500ms
CLRF LATB

GOTO Loop
;------------------------------------------------
;Secuencia invertida
;------------------------------------------------

SecuenciaInvertida:
BSF LATB 3



MOVLW 5
MOVWF Ciclos
DelayOn:
  CALL Retardo_1s
DECF 
SZ Ciclos, F
GOTO DelayOn
GOTO Apagado

;Apagar LEDs 2 segundos
CLRF LATB
MOVLW 2
MOVWF Ciclos

Apagado:
CLRF LATB
MOVLW 2
MOVWF Ciclos

DelayOff:
CALL Retardo_1s 
DECFSZ Ciclos, F
GOTO DelayOff
GOTO Loop

LedOFF:
CLRF LATB
GOTO Loop

;-----------------------------------------------
; Subrutina: Retardo de menos de 1 segundo
;-----------------------------------------------

Retardo_1s : 
MOVLW 8
MOVWF ContadorExterno

LoopExterno:
MOVLW 200
MOVWF ContadorMedio

LoopMedio:
MOVLW 250
MOVWF LoopInterno

LoopInterno:
NOP
NOP
NOP

DECFSZ ContadorInterno , F
GOTO LoopInterno

DECFSZ ContadorMedio, F
GOTO LoopMedio 

DECFSZ ContadorExterno, F
GOTO LoopExterno

RETURN  ; Recordar, subrutina SIEMPRE termina en RETURN

;----------------------------------------------------
; Variables
;----------------------------------------------------

PSECT udata
ContadorExterno: DS 1
ContadorInterno : DS 1
ContadorMedio: DS 1
Ciclos: DS 1

END
     




