// LIBRERÍAS 
#include <WiFi.h>
#include <WebServer.h>
#include <DHT.h>
#include <Adafruit_GFX.h>
#include <Adafruit_SSD1306.h>
#include <Wire.h>
#include <RTClib.h>

// WiFi 
const char* ssid     = "Tugo";
const char* password = "1122334466";

// DHT22 
#define DHTPIN 27
#define DHTTYPE DHT22
DHT dht(DHTPIN, DHTTYPE);

// FOTORESISTENCIA 
#define LDR_PIN 34   // Entrada analógica
int luzValue = 0;
String modo = "Día"; // Día o Noche

// ------------------- RTC -------------------
RTC_DS3231 rtc;

// ------------------- OLED -------------------
#define SCREEN_WIDTH 128
#define SCREEN_HEIGHT 64
Adafruit_SSD1306 display(SCREEN_WIDTH, SCREEN_HEIGHT, &Wire, -1);

// ------------------- SERVIDOR WEB -------------------
WebServer server(80);

// Variables del sistema
bool sistemaActivo = true;

// Valores
float temp = 0, hum = 0;
float tempMax = -1000, tempMin = 1000;
float humMax  = -1000, humMin  = 1000;

// HTML WEB 
const char index_html[] PROGMEM = R"rawliteral(
<!DOCTYPE HTML>
<html>
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<style>
  body { font-family: Arial; text-align: center; background-color: #f2f2f2; }
  h2 { font-size: 2rem; }
  .btn { padding: 12px 20px; background: #007bff; color:white; border:none; border-radius:8px; font-size:1.2rem; cursor:pointer; }
  .night { background: #222; color:white; }
</style>
</head>
<body id="body">

<h2>Monitor IoT ESP32</h2>

<button class="btn" onclick="toggleSystem()">Encender/Apagar Sistema</button>

<h3>Temperatura: <span id="t">--</span> °C</h3>
<h3>Humedad: <span id="h">--</span> %</h3>
<h3>Luz: <span id="l">--</span></h3>
<h3>Modo: <span id="m">--</span></h3>
<h3>Fecha/Hora: <span id="fh">--</span></h3>

<script>
function updateData() {
  fetch('/sensors')
    .then(res => res.json())
    .then(data => {
      document.getElementById("t").textContent = data.temp.toFixed(1);
      document.getElementById("h").textContent = data.hum.toFixed(1);
      document.getElementById("l").textContent = data.luz;
      document.getElementById("m").textContent = data.modo;
      document.getElementById("fh").textContent = data.fecha;

      // Modo noche cambia fondo
      if (data.modo === "Noche") {
        document.body.className = "night";
      } else {
        document.body.className = "";
      }
    });
}
setInterval(updateData, 2000);

function toggleSystem() {
  fetch('/toggle');
}
</script>

</body>
</html>
)rawliteral";


// FUNCIÓN JSON PARA EL WEB 


void handleSensorData() {

  if (sistemaActivo) {
    // Lecturas
    temp = dht.readTemperature();
    hum = dht.readHumidity();
    luzValue = analogRead(LDR_PIN);

    // Modo día/noche
    if (luzValue < 1500) modo = "Noche";
    else modo = "Día";

    // Máx y mín
    if (!isnan(temp) && !isnan(hum)) {
      if (temp > tempMax) tempMax = temp;
      if (temp < tempMin) tempMin = temp;
      if (hum > humMax) humMax = hum;
      if (hum < humMin) humMin = hum;
    }
  }

  DateTime now = rtc.now();
  char fecha[30];
  sprintf(fecha, "%02d/%02d/%04d %02d:%02d:%02d", 
          now.day(), now.month(), now.year(),
          now.hour(), now.minute(), now.second());

  String json = "{";
  json += "\"temp\":" + String(temp) + ",";
  json += "\"hum\":" + String(hum) + ",";
  json += "\"luz\":" + String(luzValue) + ",";
  json += "\"modo\":\"" + modo + "\",";
  json += "\"fecha\":\"" + String(fecha) + "\"";
  json += "}";

  server.send(200, "application/json", json);
}

// --------------------------------------------------
void toggleSystem() {
  sistemaActivo = !sistemaActivo;
  server.send(200, "text/plain", "OK");
}

// --------------------------------------------------
void mostrarOLED() {
  display.clearDisplay();
  display.setTextSize(1);
  display.setTextColor(SSD1306_WHITE);

  display.setCursor(0,0);
  display.print("Temp: "); display.print(temp); display.println(" C");
  display.print("Hum:  "); display.print(hum); display.println(" %");
  display.print("Luz:  "); display.println(luzValue);
  display.print("Modo: "); display.println(modo);

  DateTime now = rtc.now();
  display.print(now.day()); display.print("/");
  display.print(now.month()); display.print("/");
  display.print(now.year());
  
  display.println();
  display.print(now.hour()); display.print(":");
  display.print(now.minute()); display.print(":");
  display.println(now.second());

  display.display();
}


// SETUP 
void setup() {
  Serial.begin(115200);

  dht.begin();
  Wire.begin(21, 22);

  if (!rtc.begin()) {
    Serial.println("ERROR: No se encuentra el RTC!");
  }

  if (!display.begin(SSD1306_SWITCHCAPVCC, 0x3C)) {
    Serial.println("OLED no encontrada");
    for(;;);
  }

  WiFi.begin(ssid, password);
  Serial.print("Conectando a WiFi...");
  while (WiFi.status() != WL_CONNECTED) {
    delay(1000);
    Serial.print(".");
  }
  Serial.println("\nConectado!");
  Serial.print("IP: ");
  Serial.println(WiFi.localIP());

  server.on("/", HTTP_GET, []() {
    server.send_P(200, "text/html", index_html);
  });

  server.on("/sensors", HTTP_GET, handleSensorData);
  server.on("/toggle", HTTP_GET, toggleSystem);

  server.begin();
}


// LOOP 
void loop() {
  server.handleClient();
  mostrarOLED();
  delay(500);
}
